# The image builds omp-web from source, so the context is the repository minus
# everything the Next.js build does not read: local artifacts, secrets, and the
# Desktop packaging output is not part of the web container.
.git
.gitignore
.github
.claude
.factory

node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

desktop/dist
desktop/resources
desktop/server
desktop/server.staging
desktop/server.previous

docs
*.md

.env*
*.pem
.vercel
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

Dockerfile
.dockerignore
docker-compose.yml
