# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
desktop/dist/
desktop/resources/
desktop/server/
desktop/server.staging/
desktop/server.previous/

# private working tickets, never published
desktop/node_modules/

# local study notes and extracted references, never published
.study/

# scratch logs from a development run, never published
tmp-*.log

# throwaway prototypes and scratch artifacts, never published
.scratch/

# Claude Code links into .agents/skills, made by "bun run skills:link".
# Never commit a link. Git stores it as a text file or as a second copy.
/.claude/skills/*
!/.claude/skills/gitnexus-*
