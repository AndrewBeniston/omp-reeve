{
  "name": "omp-reeve",
  "version": "0.6.1",
  "private": true,
  "description": "Reeve, a desktop workspace for the OMP coding agent",
  "homepage": "https://github.com/AndrewBeniston/omp-reeve#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBeniston/omp-reeve.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewBeniston/omp-reeve/issues"
  },
  "keywords": [
    "reeve",
    "omp",
    "oh-my-pi",
    "coding-agent",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "bin": {
    "reeve": "bin/omp-web.js"
  },
  "files": [
    "bin",
    "!bin/*.test.mjs",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun --bun next dev --webpack -H 127.0.0.1 -p 30141",
    "dev:lan": "bun --bun next dev --webpack -H 0.0.0.0 -p 30141",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start -H 127.0.0.1 -p 30141",
    "start:lan": "bun --bun next start -H 0.0.0.0 -p 30141",
    "lint": "eslint . && bun run check:ui-styles",
    "check:ui-styles": "bun scripts/check-ui-style-boundaries.mjs",
    "clean": "bun scripts/clean.mjs",
    "skills:link": "bun scripts/link-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "desktop:build": "bun scripts/build-desktop.mjs",
    "desktop:artifact-path": "bun scripts/desktop-artifact-path.mjs",
    "desktop:dev": "bun scripts/dev-desktop.mjs",
    "desktop:fetch-bun": "bun scripts/fetch-bun.mjs",
    "desktop:sync-version": "bun scripts/sync-version.mjs",
    "desktop:update-feed": "bun scripts/update-feed.mjs",
    "desktop:verify-package": "bun scripts/verify-desktop-package.mjs",
    "release": "bun scripts/release.mjs",
    "release:check": "bun scripts/release-check.mjs",
    "release:notes": "bun scripts/release-notes.mjs",
    "test:shell": "ELECTRON_RUN_AS_NODE=1 electron --test desktop/terminal-shell.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@oh-my-pi/pi-agent-core": "~18.1.18",
    "@oh-my-pi/pi-ai": "~18.1.18",
    "@oh-my-pi/pi-coding-agent": "~18.1.18",
    "@oh-my-pi/pi-tui": "~18.1.18",
    "@oh-my-pi/pi-utils": "~18.1.18",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "js-yaml": "^5.4.1",
    "lucide-react": "^1.41.0",
    "next": "16.2.12",
    "proper-lockfile": "4.1.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "undici": "8.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.andrewbeniston.reeve",
    "productName": "Reeve",
    "asar": true,
    "directories": {
      "app": "desktop",
      "output": "desktop/dist",
      "buildResources": "desktop/icons"
    },
    "files": [
      "*.cjs",
      "!*.test.cjs",
      "targets.json",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop/server/.next",
        "to": "server/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop/server",
        "to": "server",
        "filter": [
          "bin/**/*",
          "public/**/*",
          "next.config.ts",
          "package.json",
          "CHANGELOG.md",
          "bun.lock",
          "bun-*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/icons/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "publish": {
        "provider": "generic",
        "url": "https://andrewbeniston.github.io/omp-reeve/updates/darwin/"
      }
    },
    "win": {
      "icon": "desktop/icons/icon.ico",
      "artifactName": "Reeve-Setup-${version}.${ext}",
      "publish": {
        "provider": "generic",
        "url": "https://andrewbeniston.github.io/omp-reeve/updates/win32/"
      }
    },
    "linux": {
      "category": "Development",
      "icon": "desktop/icons/icon.png",
      "executableName": "reeve",
      "publish": {
        "provider": "generic",
        "url": "https://andrewbeniston.github.io/omp-reeve/updates/linux/"
      },
      "artifactName": "Reeve-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  }
}
